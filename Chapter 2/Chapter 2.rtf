2.24 Largest and Smallest Integers\par
\par
Question: Write an application that reads five integers and determines and prints the largest and smallest integers.\par
\par
Answer\par
\par
import java.util.Scanner;\par
\par
public class LargestSmallest \{\par
    public static void main(String[] args) \{\par
\par
        Scanner input = new Scanner(System.in);\par
\par
        System.out.print("Enter first integer: ");\par
        int a = input.nextInt();\par
\par
        System.out.print("Enter second integer: ");\par
        int b = input.nextInt();\par
\par
        System.out.print("Enter third integer: ");\par
        int c = input.nextInt();\par
\par
        System.out.print("Enter fourth integer: ");\par
        int d = input.nextInt();\par
\par
        System.out.print("Enter fifth integer: ");\par
        int e = input.nextInt();\par
\par
        int largest = a;\par
        int smallest = a;\par
\par
        if (b > largest) largest = b;\par
        if (c > largest) largest = c;\par
        if (d > largest) largest = d;\par
        if (e > largest) largest = e;\par
\par
        if (b < smallest) smallest = b;\par
        if (c < smallest) smallest = c;\par
        if (d < smallest) smallest = d;\par
        if (e < smallest) smallest = e;\par
\par
        System.out.printf("Largest: %d%n", largest);\par
        System.out.printf("Smallest: %d%n", smallest);\par
\par
        input.close();\par
    \}\par
\}\par
\par
Example output\par
\par
Enter first integer: 10\par
Enter second integer: 5\par
Enter third integer: 20\par
Enter fourth integer: 8\par
Enter fifth integer: 2\par
Largest: 20\par
Smallest: 2\par
\par
Explanation:\par
\par
